# Copy this file to .env.local and fill in your values

# Acuity Scheduling owner ID (found in your Acuity embed URL)
# NEXT_PUBLIC_ACUITY_OWNER_ID=YOUR_OWNER_ID

# Google Maps embed URL (from Google Maps > Share > Embed a map > Copy HTML)
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=YOUR_EMBED_URL

# Contact form endpoint (e.g., Formspree form ID)
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Site base URL (no trailing slash)
# NEXT_PUBLIC_SITE_URL=https://truidentity956.com
