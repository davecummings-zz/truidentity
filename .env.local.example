# Copy this file to .env.local and fill in your values

# Google Places API key — required for live reviews on the homepage
# Enable "Places API (New)" in Google Cloud Console, then restrict the key to server-side use only.
# To find the Place ID: set this key, then run:
#   curl -X POST "https://places.googleapis.com/v1/places:searchText" \
#     -H "Content-Type: application/json" \
#     -H "X-Goog-Api-Key: YOUR_KEY" \
#     -H "X-Goog-FieldMask: places.id,places.displayName" \
#     -d '{"textQuery":"TruIdentity Screening Solutions 813 N Main St McAllen TX"}'
# Copy the returned `id` value (e.g. "ChIJ...") into config/site.ts > googlePlaceId.
# Also update googleBusinessUrl in config/site.ts with the Google Maps link to the business profile.
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Acuity Scheduling owner ID (found in your Acuity embed URL)
# NEXT_PUBLIC_ACUITY_OWNER_ID=YOUR_OWNER_ID

# Resend API key — required for contact form email delivery
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Google Analytics 4 Measurement IDs
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-your_measurement_id
NEXT_PUBLIC_GA_MEASUREMENT_ID_2=G-your_second_measurement_id

# Site base URL (no trailing slash)
# NEXT_PUBLIC_SITE_URL=https://truidentity956.com
